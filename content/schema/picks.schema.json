{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaogong.local/schema/picks.schema.json",
  "title": "Picks",
  "description": "每日选材定稿：槽位分配与精选清单（curate_content 产出，工作台与前端消费）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "slots", "picked", "assignments"],
  "properties": {
    "date": { "type": "string", "format": "date", "description": "YYYY-MM-DD" },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "essay", "exam", "extra"],
      "properties": {
        "headline": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }], "description": "头版要闻（可脱离主线池）" },
        "essay": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "申论精读 ≤2" },
        "exam": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }], "description": "考点提炼" },
        "extra": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }], "description": "多样性补充" },
        "supplement": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "历史补剧（仅下限不足时；v2.1 §7.1 起不再写入，键保留兼容历史产物）" },
        "sparse": { "type": "boolean", "description": "宁缺勿滥标记（v2.1 §7.1）：picked<2 时置 true，当日为合法 sparse 日" }
      }
    },
    "picked": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 },
      "description": "最终精选 0-5 篇（v2.1 §7.1 宁缺勿滥：下限 2→0；picked=0 不落盘，1≤picked<2 时 slots.sparse=true）"
    },
    "assignments": {
      "type": "object",
      "additionalProperties": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
      "description": "文章 id → 主线归属（AI 评级结果；null=无归属）"
    },
    "needsHuman": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "待人工审核名单（v2.1 §7.2）：发布会/调研类模糊地带与无 key 兜底，不进槽位、交 review 工作台；T04 起恒写入（可空数组）"
    }
  }
}
