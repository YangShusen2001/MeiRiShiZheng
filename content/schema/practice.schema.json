{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaogong.local/schema/practice.schema.json",
  "title": "PracticeSet",
  "description": "一天的每日一练题集（管道产出 → apps/web 消费）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "total", "questions"],
  "properties": {
    "date": { "type": "string", "format": "date", "description": "YYYY-MM-DD" },
    "total": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "minLength": 1 },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "q", "options", "answer", "analysis", "topic"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "q": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 4, "maxItems": 4 },
        "answer": { "type": "integer", "minimum": 0, "maximum": 3 },
        "analysis": { "type": "string", "minLength": 1 },
        "topic": { "type": "string", "minLength": 1 },
        "hint": {
          "type": "string",
          "minLength": 4,
          "maxLength": 60,
          "description": "一句话提示（指向材料依据或关键区分点，不直接给出答案）。可选：画布 3:608「查看提示」按钮展开它；未生成时端上退回 topic，不编造"
        },
        "traps": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string", "maxLength": 12 },
          "description": "4 个选项各自的典型误因，与 options 同下标；正确项固定空串（画布 3:617「错因：漏读题干」那一行取 traps[chosen]）。可选：未生成时端上退回「你的 X → 正确 Y」，不编造"
        }
      }
    }
  }
}
