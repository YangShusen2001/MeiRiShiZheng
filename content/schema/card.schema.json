{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaogong.local/schema/card.schema.json",
  "title": "CardDeck",
  "description": "一组考点卡片（策展静态内容或管道 AI 提炼产物 → apps/web 消费，不分用户）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy", "cards"],
  "properties": {
    "policy": { "type": "string", "minLength": 1, "description": "卡组所属政策/文件，如「十五五规划建议」" },
    "policyLine": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "整组卡归属的主线 slug（policy-lines.json 的 id）；card 级 policyLine 可覆盖"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "answer", "tags"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "全局唯一卡片 id" },
        "question": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "正面问题（主动回忆）；黄金样本最短 10 字"
        },
        "answer": {
          "type": "string",
          "minLength": 6,
          "maxLength": 200,
          "description": "反面答案；黄金样本（数字卡）最短 6 字"
        },
        "explain": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400,
          "description": "思路/逐项解析（可选）。答完题展示，让用户知道为什么错——只给对错等于白刷。由内容管道生成，未生成时端上按「考点归属」给基础解析"
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1 },
          "description": "标签，如 定位/目标/数字"
        },
        "policyLine": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "卡片归属的主线 slug；缺省继承卡组 policyLine"
        },
        "examPointId": {
          "type": "string",
          "minLength": 1,
          "description": "所属考点（结构化考点库阶段 2；可先于考点库使用自由 id）"
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["articleId", "paragraphIndex"],
          "properties": {
            "articleId": { "type": "string", "minLength": 1, "description": "出处文章 id" },
            "paragraphIndex": { "type": "integer", "minimum": 0, "description": "出处段落下标" },
            "sentence": { "type": "string", "minLength": 1, "description": "出处句子（跨段定位出错时的兜底文本）" }
          },
          "description": "卡片↔精读锚定（0022 阶段 2）：卡片来源于哪篇文章哪一段"
        }
      }
    }
  }
}
