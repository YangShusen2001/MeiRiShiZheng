# 依赖
node_modules/

# WSL 构建的依赖目录：其中的符号链接是 Linux 的 LX symlink（重解析标签 0xa000001d），
# Windows 原生进程（node/python/pnpm）无法解析，会报 EACCES / WinError 1920。
# 重新在 Windows 侧安装前改名留存；`.broken` 为安装被安全护栏打断后的半成品。
# 两者都只是旧副本，确认新安装可用后可安全删除。
node_modules.wsl.old/
node_modules.broken/
apps/*/node_modules.wsl.old/
apps/*/node_modules.broken/
packages/*/node_modules.wsl.old/
packages/*/node_modules.broken/

# pnpm 安装过程被中断时留下的临时文件（0 字节，形如 _tmp_<pid>_<hash>）
_tmp_*
# pytest 运行临时产物
_tmp_pytest/
# WorkBuddy 本地会话记忆与项目数据（单机本地，不入库）
.workbuddy/

# 构建产物
dist/
.wrangler/
apps/api/.wrangler-qa/
.astro/
test-results/
playwright-report/

# 环境变量（含密钥，永不入库）
.env
.env.*
.dev.vars
!.env.example
!.env.local.example

# 日志 / 系统文件
*.log
.DS_Store

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# 本地运行时配置（审核后台写入；仓库构建对缺失有默认回退）
apps/web/src/site-config.json
apps/web/src/font-config.json

# 内容分发产物：由 apps/web/scripts/build-content-api.mjs 从 content/ 生成，随构建产出，不入库
apps/web/public/content/

# 生产配置：本地保留真实值，仓库只放 wrangler.toml.example
apps/api/wrangler.toml

# 抓取内容：真实日期内容与质量报告不进仓库（版权与体积），仅保留 2026-08-17 示例日
content/20*/
content/_reports/
!content/2026-08-17/
content/2026-08-17/*
!content/2026-08-17/digest.json
!content/2026-08-17/summary.json
!content/2026-08-17/practice.json
!content/2026-08-17/article-f80313d7b2.json
!content/2026-08-17/article-6e0c51c3aa.json
!content/2026-08-17/article-4f3380992f.json
!content/2026-08-17/article-917eeba614.json

# 政策档案（content/archive/）：清单与 AI 档案入库——站点构建时直接读取（Pages 云端构建需要），
# 正文 article-*.json 不入库（体量大且站点只用 gist，不渲染正文）。
content/archive/*/article-*.json

# 商用字体（版权未授权，需自备；缺失时回退系统字体）
apps/web/public/fonts/*
!apps/web/public/fonts/README.md

# 本地杂物
.omo/
pipeline/_test_subset.woff2
scripts/local-daily.bat

# HarmonyOS 工程（apps/harmony）构建产物与本地环境
apps/harmony/**/build/
apps/harmony/**/oh_modules/
apps/harmony/**/.cxx/
apps/harmony/**/.preview/
apps/harmony/.hvigor/
apps/harmony/.clangd
apps/harmony/.clang-format
apps/harmony/local.properties
apps/harmony/**/*.har
apps/harmony/**/oh-package-lock.json5
.demo-shots/
