---
import Base from "../../layouts/Base.astro";
import { listArticles, listArchiveArticles } from "../../lib/content";
import type { ClippedArticle } from "@kaogong/contracts";

// 剪藏文章 + 政策档案正文**共用同一条** /read/<id>/ 路由。
// 两者是同一个 ClippedArticle 形状（政策正文多几个 archive* 字段，不影响渲染），
// id 空间实测零冲突（241 篇 ↔ 1137 篇，交集为空），所以直接拼、不加前缀。
export function getStaticPaths() {
  return [...listArticles(), ...listArchiveArticles()].map((a) => ({
    params: { id: a.id },
    props: { article: a },
  }));
}

const { article } = Astro.props as { article: ClippedArticle };
// 政策正文带 archiveMonth（剪藏文章没有）——用它区分来源。
// 这个区分**必须**传给收藏：档案页收政策用 kind=policy，阅读页若用 article，
// 同一篇政策会存成两条不同 kind 的记录，收藏页的「政策」格就永远收不到阅读页收的那条。
const archiveMonth = (article as ClippedArticle & { archiveMonth?: string }).archiveMonth;
const isPolicy = Boolean(archiveMonth);
const favKind = isPolicy ? "policy" : "article";
const aiAnnotations = article.aiStatus === "ok" ? article.aiAnnotations ?? [] : [];
const aiSummary = article.aiStatus === "ok" ? article.aiSummary?.trim() ?? "" : "";
const keySentences = article.keySentences ?? [];

/**
 * 标注分组（画布 3:223 / 3:227 / 3:231 / 3:235）。
 * 画布上的组标签是**纯文字胶囊 + 条数**（「考点 3」），不是图标——
 * 原先是 🎯📌📖，那是 emoji，跟不了令牌也做不了主题翻转，已按画布去掉。
 * 标签底色直接用 highlight 令牌本身：考点 #FFE7A0 / 观点 #C9E7CE / 术语 #B9DEE6，
 * 与正文里同类型标注片段是同一个色，读者一眼能把「速览里的这行」和「正文里的那块」对上。
 */
const ANNOTATION_GROUPS: Array<{ type: string; label: string; tag: string }> = [
  { type: "exam_point", label: "考点", tag: "exam" },
  { type: "viewpoint", label: "观点", tag: "view" },
  { type: "term", label: "术语", tag: "term" },
];
const annotationGroups = ANNOTATION_GROUPS
  .map((g) => ({ ...g, items: aiAnnotations.filter((a) => a.type === g.type) }))
  .filter((g) => g.items.length > 0);
const hasBrief = Boolean(aiSummary || annotationGroups.length || keySentences.length);

// 来源行（画布 3:195「新华社 · 2026-09-12 · 原文 1610 字 · 阅读约 6 分钟」）。
// 字数与时长构建期实算，不写死：中文按 300 字/分钟估，向上取整（宁可说多一分钟）。
const charCount = article.paragraphs.reduce((n, p) => n + p.length, 0);
const readMinutes = Math.max(1, Math.ceil(charCount / 300));
// 读完卡（画布 3:269）的说明文案：条数同样实算。
const annotationCount = aiAnnotations.length;
---
<Base title={`${article.title} · 时政小助手`} variant="reading" bleed>
  {/* ===== 文章头（画布 3:192）：pad 64/48/32，内容列 820 定宽 =====
      画布上是**无卡片**的版式——没有底色、没有描边、没有圆角，直接坐在页面底色上。
      原先那套「白卡 + 居中 + 20px 内距」跟画布不是一回事，已换掉。 */}
  <div class="rd-head">
    <div class="rd-head__in">
      <div class="rd-col">
        {/* 来源行（画布 3:194）：gap 12，右侧「查看官方原文」+ 12×12 外链图标（矢量，不是 ↗ 字符） */}
        <div class="rd-src">
          <span class="rd-src__info">{article.source} · {article.date} · 原文 {charCount} 字 · 阅读约 {readMinutes} 分钟</span>
          <a class="rd-src__link" href={article.url} target="_blank" rel="noopener">
            <span>查看官方原文</span>
            <svg class="rd-src__ic" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M7.2 2.4h2.4v2.4M9.4 2.6 5.6 6.4M9 7.6v1.8H2.6v-6h1.8" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
        <h1 class="rd-title">{article.title}</h1>
        {/* 操作栏（画布 3:202）：wrap · gap 10，三个胶囊等宽同行
            1) 收藏本文（h40 · pad 0 18 · 圆角 999 · 白底 + 描边）
            2) 阅读模式切换（h40 · pad 4 · 底 sunken · 内含两段 h32）
            3) 阅读工具条（h40 · pad 0 16 · gap 16 · 白底 + 描边，五项纯文字）
            「全屏」不在画布上——浏览器本身就支持，不再占一个按钮位。 */}
        <div class="rd-acts">
          <button
            type="button"
            class="rd-fav"
            id="read-fav"
            data-fav-toggle
            data-title={article.title}
            data-url={article.url}
            data-fav-kind={favKind}
          >收藏本文</button>
          <div class="rd-mode" role="group" aria-label="阅读模式">
            <button type="button" id="mode-original" class="on" aria-pressed="true">原文模式</button>
            <button type="button" id="mode-ai" aria-pressed="false" disabled>AI 标注模式</button>
          </div>
          <div class="rd-tools">
            <button type="button" class="rd-tool-strong" id="font-minus" title="缩小字号">A-</button>
            <button type="button" class="rd-tool-strong" id="font-plus" title="放大字号">A+</button>
            <button type="button" id="font-cycle" title="切换字体：默认 / 宋体 / 楷体 / 黑体 / 瘦金">字体：默认</button>
            <button type="button" id="immersive" title="隐藏顶栏与页脚">沉浸阅读</button>
            <button type="button" id="link-mode" title="显示论证连线（LiquidText 式）" disabled>论证连线</button>
          </div>
        </div>
        {/* AI 额度（画布 3:216）：12px 的次级说明，前缀是固定的 */}
        <div class="rd-quota">
          <span class="rd-quota__k">AI 解析额度：</span>
          <span class="rd-quota__v" id="ai-quota-text">加载中…</span>
          <button type="button" class="rd-quota__act" id="ai-quota-action" hidden>输入邀请码</button>
        </div>
        {/* AI 标注不可用时的说明。放在内容列里而不是外层 —— 它是文章头的一部分，
            挂在外层就只能自己再算一遍 820 列与 64px 内距。 */}
        <p class="ai-mode-status" id="ai-mode-status" hidden></p>
      </div>
    </div>
  </div>

  {/* ===== 正文区（画布 3:217）：pad 64/8/72，内容列 820 ===== */}
  <div class="rd-body">
    <div class="rd-body__in">
      <div class="rd-col">
        {/* AI 速览卡（画布 3:218）：820 · 圆角 14 · pad 20 · gap 14 · 白底 + 描边。
            画布上是**展开的卡**（不是折叠的 <details>）——它把「考点/观点/术语/金句」
            四组直接摊开，右上角写「点击条目跳到对应段落」。所以折叠壳撤掉。
            组内多条排成连贯的一行、用「·」分隔（画布 3:226/3:230/3:234 就是这么排的），
            但每一条仍是独立可点的按钮——「跳到对应段落」这个能力不能因为合并成行就丢掉。 */}
        {hasBrief && (
          <section class="ai-brief" id="ai-brief">
            <div class="ai-brief__head">
              <h2 class="ai-brief__title">AI 速览</h2>
              <span class="ai-brief__hint">点击条目跳到对应段落</span>
            </div>
            {aiSummary && <p class="ai-brief__sum">{aiSummary}</p>}
            {annotationGroups.map((g) => (
              <div class="ai-group">
                <span class={`ai-tag ai-tag--${g.tag}`}>{g.label} {g.items.length}</span>
                <div class="ai-group__body">
                  {g.items.map((a, i) => (
                    <>
                      {i > 0 && <span class="ai-sep" aria-hidden="true">·</span>}
                      <button type="button" class="ai-item" data-para={a.paragraphIndex} title={a.explanation}>{a.text}</button>
                    </>
                  ))}
                </div>
              </div>
            ))}
            {keySentences.length > 0 && (
              <div class="ai-group">
                <span class="ai-tag ai-tag--quote">金句 {keySentences.length}</span>
                <div class="ai-group__body">
                  {keySentences.map((k, i) => (
                    <>
                      {i > 0 && <span class="ai-sep" aria-hidden="true">·</span>}
                      {/* 金句在画布上是**衬线 Medium**（3:238），与其他三组的无衬线正文区分开 */}
                      <span class="ai-item ai-item--quote">{k}</span>
                    </>
                  ))}
                </div>
              </div>
            )}
          </section>
        )}

        <article class="reading" id="article" data-id={article.id} data-ai-status={article.aiStatus ?? "legacy"}>
          {/* 金句引文（画布 3:240）：820 × min-h 100 · 圆角 10 · 底 sunken ·
              左侧 3px accent 竖线 · 内距 16/20/16/17 · 20px 衬线 Medium / 32 行高 */}
          {keySentences.length > 0 && (
            <div class="rd-quote"><blockquote>{keySentences[0]}</blockquote></div>
          )}
          {article.paragraphs.map((p) => <p class="reading-para">{p}</p>)}
          {/* 读完操作卡（画布 3:269）：圆角 14 · pad 20 · gap 14 · 底 sunken。
              第二个按钮画布写的是「生成摘录卡」——线上没有这个能力（要生成卡片得先有
              导出/合成那套），不摆假按钮占位，换成真实有用的「回到顶部」。 */}
          <div class="rd-done">
            <p class="rd-done__text">
              读完了 · 本文 {annotationCount} 处标注、{keySentences.length} 句金句可同步到收藏
            </p>
            <div class="rd-done__acts">
              <button type="button" class="rd-fav rd-fav--solid" data-fav-toggle>收藏本文</button>
              <a class="rd-top" href="#top">回到顶部</a>
            </div>
          </div>
          <div class="relation-overlay" aria-hidden="true"><svg></svg></div>
        </article>
      </div>
    </div>
  </div>

  <script type="application/json" id="ai-annotations" set:html={JSON.stringify(aiAnnotations).replace(/</g, "\\u003c")}></script>
  {(article.aiRelations?.length ?? 0) > 0 && (
    <script type="application/json" id="ai-relations" set:html={JSON.stringify(article.aiRelations).replace(/</g, "\\u003c")}></script>
  )}

  <div id="hl-toolbar" class="hl-toolbar" hidden>
    <button type="button" data-act="green">荧光笔</button>
    <button type="button" data-act="underline">下划线</button>
    <button type="button" data-act="bold">加粗</button>
    <button type="button" data-act="explain">AI 解释</button>
    <button type="button" data-act="favorite">收藏</button>
  </div>

  <div class="invite-modal" id="invite-modal" hidden>
    <div class="invite-modal-card" role="dialog" aria-modal="true" aria-labelledby="invite-modal-title">
      <h3 id="invite-modal-title">输入 AI 解析邀请码</h3>
      <p class="item-summary">未登录时，AI 解析需要邀请码。激活后绑定到当前设备，从共享额度按次扣减。</p>
      <input id="invite-input" type="text" autocomplete="off" spellcheck="false" placeholder="请输入邀请码" />
      <p class="invite-error" id="invite-error" role="alert" hidden></p>
      <div class="invite-modal-actions">
        <button type="button" id="invite-cancel" class="btn btn--line btn--sm">取消</button>
        <button type="button" id="invite-submit" class="btn btn--solid btn--sm">激活</button>
      </div>
    </div>
  </div>

  <div class="rel-mobile-panel" id="rel-mobile-panel" hidden>
    <div class="rel-mobile-head">
      <span>论证结构</span>
      <button type="button" id="rel-mobile-close" aria-label="关闭">×</button>
    </div>
    <div id="rel-mobile-body"></div>
  </div>
</Base>

<script>
  import { api } from "../../lib/api";
  import { isLocalFavorite, toggleLocalFavorite, loadLocalFavorites, toggleLocalTermFavorite } from "../../lib/local-favorites";
  import {
    createHighlight, removeHighlight, removeRangeFromHighlight, highlightAt, flattenRanges,
    relocateHighlight, migrateV1ToV2,
    type Highlight, type HighlightRange, type LegacyHighlightRecord, type Span,
  } from "../../lib/highlights";
  import { readerSegmentsToHtml, validAiAnnotations, buildReaderSegments } from "../../lib/reader-annotations";
  import { drawRelationOverlay, relationSpanMap, validRelations } from "../../lib/reader-relations";
  import { renderMarkdown } from "../../lib/markdown";
  import type { AiAnnotation, AiRelation, HighlightStyle } from "@kaogong/contracts";

  const articleEl = document.getElementById("article") as HTMLElement;
  const toolbar = document.getElementById("hl-toolbar") as HTMLElement;
  const articleId = articleEl.dataset.id || "";
  const paraEls = Array.from(articleEl.querySelectorAll<HTMLElement>(".reading-para"));

  // AI 速览：点击考点/观点/术语节点跳转到对应段落
  document.querySelectorAll<HTMLButtonElement>(".ai-item[data-para]").forEach((node) => {
    node.addEventListener("click", () => {
      const idx = Number(node.dataset.para);
      const para = paraEls[idx];
      if (para) {
        para.scrollIntoView({ behavior: "smooth", block: "center" });
        para.classList.add("ai-jump-flash");
        window.setTimeout(() => para.classList.remove("ai-jump-flash"), 1500);
      }
    });
  });

  // 文章各段落原文（从初始 DOM 读取，重渲染前捕获一次），是偏移计算与重渲染的唯一事实源。
  const paraText: string[] = paraEls.map((el) => el.textContent ?? "");
  const aiStatus = articleEl.dataset.aiStatus;
  const annotationData = document.getElementById("ai-annotations")?.textContent ?? "[]";
  let aiAnnotations: AiAnnotation[] = [];
  try {
    aiAnnotations = JSON.parse(annotationData) as AiAnnotation[];
  } catch {
    aiAnnotations = [];
  }
  const validAnnotations = aiAnnotations.filter((annotation) => {
    const text = paraText[annotation.paragraphIndex];
    return text !== undefined && validAiAnnotations(text, [annotation]).length === 1;
  });
  // 关系标注（箭头）：仅 AI 模式显示；引用失效的关系被过滤
  const relationsData = document.getElementById("ai-relations")?.textContent ?? "[]";
  let aiRelationsVal: AiRelation[] = [];
  try {
    aiRelationsVal = JSON.parse(relationsData) as AiRelation[];
  } catch {
    aiRelationsVal = [];
  }
  const validRel = validRelations(aiRelationsVal, validAnnotations);
  const relByAnnotation = relationSpanMap(validRel, validAnnotations);
  let aiMode = false;

  const originalModeButton = document.getElementById("mode-original") as HTMLButtonElement;
  const aiModeButton = document.getElementById("mode-ai") as HTMLButtonElement;
  const aiModeStatus = document.getElementById("ai-mode-status") as HTMLElement;
  const aiAvailable = aiStatus === "ok" && validAnnotations.length > 0;
  aiModeButton.disabled = !aiAvailable;
  if (!aiAvailable) {
    aiModeStatus.hidden = false;
    aiModeStatus.textContent = aiStatus === "error"
      ? "AI 标注生成失败，当前仍可阅读完整原文。"
      : "这篇文章暂时没有 AI 标注，当前显示完整原文。";
  }

  // ===== 字体 / 沉浸 =====
  const FONT_SIZE_KEY = "kaogong.read.fontsize";
  const FONT_NAME_KEY = "kaogong.read.font";
  const FONTS: Record<string, string> = {
    default: "var(--font)",
    serif: "var(--font-serif)",
    kai: '"KaiTi", "楷体", "STKaiti", serif',
    hei: '"SimHei", "黑体", "Microsoft YaHei", sans-serif',
    shoujin: '"瘦金简体", "汉仪瘦金书简", "ShouJinTi", "STKaiti", serif',
  };
  // 工具条里的字体项是**纯文字**（画布 3:213「字体：默认」），不是 <select>：
  // 画布的阅读工具条是一排等高的文字项，塞一个下拉框会破坏这一行的节奏。
  // 点一次换下一种，标签跟着变（「字体：宋体」），顺序即 FONT_ORDER。
  const FONT_LABELS: Record<string, string> = {
    default: "默认", serif: "宋体", kai: "楷体", hei: "黑体", shoujin: "瘦金",
  };
  const FONT_ORDER = ["default", "serif", "kai", "hei", "shoujin"];

  let fontSize = Number(localStorage.getItem(FONT_SIZE_KEY)) || 17;
  function setFontSize(n: number) {
    fontSize = Math.min(26, Math.max(13, n));
    articleEl.style.fontSize = `${fontSize}px`;
    localStorage.setItem(FONT_SIZE_KEY, String(fontSize));
  }
  setFontSize(fontSize);

  const fontCycle = document.getElementById("font-cycle") as HTMLButtonElement;
  function setFont(name: string) {
    articleEl.style.fontFamily = FONTS[name] || FONTS.default!;
    localStorage.setItem(FONT_NAME_KEY, name);
    fontCycle.textContent = `字体：${FONT_LABELS[name] ?? FONT_LABELS.default}`;
  }
  const savedFont = localStorage.getItem(FONT_NAME_KEY);
  setFont(savedFont && FONTS[savedFont] ? savedFont : "default");

  document.getElementById("font-minus")!.addEventListener("click", () => setFontSize(fontSize - 1));
  document.getElementById("font-plus")!.addEventListener("click", () => setFontSize(fontSize + 1));
  fontCycle.addEventListener("click", () => {
    const next = FONT_ORDER[(FONT_ORDER.indexOf(localStorage.getItem(FONT_NAME_KEY) ?? "default") + 1) % FONT_ORDER.length]!;
    setFont(next);
  });
  const immersiveBtn = document.getElementById("immersive") as HTMLButtonElement;
  immersiveBtn.addEventListener("click", () => {
    document.body.classList.toggle("immersive");
    immersiveBtn.textContent = document.body.classList.contains("immersive") ? "退出沉浸" : "沉浸阅读";
  });
  // 「全屏」按钮撤掉（画布 3:210 的工具条只有五项，没有它）：浏览器自带 F11 / ⌃⌘F，
  // 页面里再放一个只会占掉工具条一格。

  // 收藏：登录 → 云端；未登录 → 本地 localStorage（都支持 toggle，刷新不丢失）
  // 页面上有两个收藏入口（文章头的胶囊 + 读完卡的实底按钮），状态必须联动，
  // 所以状态改由 setFavState 统一写，两个按钮只是长相不同。
  const favBtns = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-fav-toggle]"));
  const favBtn = favBtns[0]!;
  let favId: string | null = null; // 云端收藏 id（登录态）

  function setFavState(saved: boolean) {
    for (const b of favBtns) {
      b.textContent = saved ? "已收藏" : "收藏本文";
      b.classList.toggle("on", saved);
    }
  }
  function setFavBusy(busy: boolean) {
    for (const b of favBtns) b.disabled = busy;
  }

  // —— 术语收藏（0018）：正文 AI 术语整个可点击收藏（笔画加深 + 书签标记）——
  const termFavs = new Set<string>();          // 已收藏术语文本（文章内唯一）
  const termFavIds = new Map<string, string>(); // 登录态：术语文本 → 云端收藏 id
  const articleUrl = favBtn.dataset.url || "";
  const articleTitle = favBtn.dataset.title || "";

  // 已收藏标记（画布对图形的态度：矢量，不用 emoji）。
  // 形状取自底导「收藏」那一格的矢量（3:1523，9.2×13 描边书签），同源缩到 11px，
  // 颜色继承 currentColor，所以在任何底色上都能跟着文字色走。
  const BOOKMARK_ICON = '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.4 3.6h9.2v13L10 13.2l-4.6 3.4z" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"></path></svg>';

  function applyTermFavMarks() {
    paraEls.forEach((para) => {
      para.querySelectorAll<HTMLElement>("[data-term-text]").forEach((el) => {
        const t = el.dataset.termText || "";
        const faved = termFavs.has(t);
        el.classList.toggle("term-faved", faved);
        let badge = el.querySelector<HTMLElement>(".term-fav-badge");
        if (faved && !badge) {
          badge = document.createElement("span");
          badge.className = "term-fav-badge";
          badge.setAttribute("aria-hidden", "true");
          badge.innerHTML = BOOKMARK_ICON;
          el.appendChild(badge);
        } else if (!faved && badge) {
          // 取消收藏后标记整个移除：画布上未收藏的术语就是一段带底色的原文，
          // 没有角标（原先留一个 👻 是为了提示「这里能点」，现在点击态有 hover 兜底）。
          badge.remove();
        }
      });
    });
  }

  async function toggleTermFavorite(termText: string, explanation: string) {
    if (termFavs.has(termText)) {
      // 取消
      if (favLoggedIn) {
        const id = termFavIds.get(termText);
        if (id) {
          const env = await api.removeFavorite(id);
          if (!env.ok) { toast("取消术语收藏失败"); return; }
          termFavIds.delete(termText);
        }
      } else {
        toggleLocalTermFavorite(articleUrl, articleTitle, termText, explanation, articleId);
      }
      termFavs.delete(termText);
      toast("已取消术语收藏");
    } else {
      // 收藏
      if (favLoggedIn) {
        const env = await api.addFavorite({
          url: articleUrl, title: articleTitle, kind: "term",
          termText, termExplanation: explanation, articleId,
        });
        if (!env.ok || !env.data) { toast("术语收藏失败"); return; }
        termFavIds.set(termText, env.data.id);
        toast("已收藏术语");
      } else {
        toggleLocalTermFavorite(articleUrl, articleTitle, termText, explanation, articleId);
        toast("已收藏到本机");
      }
      termFavs.add(termText);
    }
    applyTermFavMarks();
  }

  document.addEventListener("click", (e) => {
    const termEl = (e.target as HTMLElement).closest<HTMLElement>("[data-term-text]");
    if (!termEl) return;
    // 与划线菜单（mark[data-user-highlight]）不重叠；避免双击重复触发
    if (e.detail > 1) return;
    const t = termEl.dataset.termText || "";
    const expl = termEl.dataset.termExpl || "";
    if (t) void toggleTermFavorite(t, expl);
  });

  let favLoggedIn = false;

  async function refreshFavState() {
    const url = favBtn.dataset.url || "";
    const me = await api.me();
    favLoggedIn = Boolean(me.ok && me.data);
    // 收藏速度优化（2026-08-20）：一次 ?url= 请求拿该文章全部收藏状态
    // （文章 favId + 术语 termFavs/termFavIds），替代此前两次全量 listFavorites
    termFavs.clear();
    termFavIds.clear();
    favId = null;
    if (favLoggedIn) {
      const list = await api.listFavorites(url);
      for (const f of list.ok ? list.data || [] : []) {
        // 整篇收藏认两种 kind：政策正文走 /read/ 后收的是 policy，
        // 只认 article 会让政策阅读页的按钮永远显示「未收藏」。
        if (f.kind === "article" || f.kind === "policy") favId = f.id;
        else if (f.kind === "term" && f.termText) {
          termFavs.add(f.termText);
          termFavIds.set(f.termText, f.id);
        }
      }
    } else {
      for (const f of loadLocalFavorites()) {
        if (f.kind === "article" && f.url === url) favId = f.id ?? null;
        else if (f.kind === "term" && f.url === url && f.termText) termFavs.add(f.termText);
      }
    }
    const saved = favLoggedIn ? favId : isLocalFavorite(url);
    setFavState(Boolean(saved));
    setFavBusy(false);
    applyTermFavMarks();
  }

  // 两个收藏入口绑同一套逻辑（state 由 setFavState 统一刷新，点击哪个都一样）
  for (const btn of favBtns) {
    btn.addEventListener("click", async () => {
      if (btn.disabled) return;
      setFavBusy(true);
      const url = btn.dataset.url || favBtn.dataset.url || "";
      const title = btn.dataset.title || favBtn.dataset.title || "";
      // 收藏类型：政策正文收成 policy（与档案页一致），剪藏文章仍是 article。
      // 第二个收藏入口（读完卡）没写 data-fav-kind，从文章头那个按钮兜底。
      const kind = (btn.dataset.favKind || favBtn.dataset.favKind || "article") as "article" | "policy";
      // 收藏速度优化：不再每次点击查登录态（页面加载时已缓存 favLoggedIn）
      if (!favLoggedIn) {
        // 未登录：本地收藏（toggle）
        const now = toggleLocalFavorite(url, title);
        setFavState(now);
        toast(now ? "已收藏到本机（登录后可同步到云端）" : "已取消本机收藏");
        setFavBusy(false);
        return;
      }
      const favError = (env: { ok: boolean; error?: { code?: string } }) =>
        env.error?.code === "AUTH_REQUIRED" ? "请先登录后再收藏"
          : env.error?.code === "NETWORK" ? "网络错误：请确认后端地址可访问"
          : "收藏失败，请重试";
      if (favId) {
        const env = await api.removeFavorite(favId);
        if (env.ok) {
          favId = null;
          setFavState(false);
          toast("已取消收藏");
        } else {
          toast(favError(env));
        }
      } else {
        const env = await api.addFavorite({
          url,
          title,
          kind,
          // 政策收藏带上站内 id，收藏页的「政策」格才能直接跳回阅读页而不是官方外链
          articleId: kind === "policy" ? articleId : "",
        });
        if (env.ok && env.data) {
          favId = env.data.id;
          setFavState(true);
          toast("已收藏");
        } else {
          toast(favError(env));
        }
      }
      setFavBusy(false);
    });
  }
  void refreshFavState();

  // ===== 划线：对象模型（v2，提案 0019 方案 B）=====
  // 一个划线 = 一个 Highlight 对象（可跨段）；删除/撤销按对象；quote 锚点防重抓错位。
  const HIGHLIGHTS_KEY_V2 = `kaogong.highlights.v2.${articleId}`;
  const HIGHLIGHTS_KEY_V1 = `kaogong.highlights.v1.${articleId}`;
  let highlights: Highlight[] = [];

  function spansFor(index: number): Span[] {
    return flattenRanges(highlights).get(index) ?? [];
  }

  function renderParagraph(index: number) {
    const para = paraEls[index];
    if (!para) return;
    const text = paraText[index] ?? para.textContent ?? "";
    const annotations = aiMode ? validAnnotations.filter((annotation) => annotation.paragraphIndex === index) : [];
    para.innerHTML = readerSegmentsToHtml(buildReaderSegments(text, spansFor(index), annotations, aiMode ? relByAnnotation : undefined));
  }

  function renderAll() {
    paraEls.forEach((_, i) => renderParagraph(i));
    applyTermFavMarks();
    redrawRelations();
  }

  // ===== 关系标注（LiquidText 式：圈 + 半透明连线，默认关闭）=====
  const overlayEl = articleEl.querySelector<HTMLDivElement>(".relation-overlay");
  let relationHandle: ReturnType<typeof drawRelationOverlay> | null = null;
  let flashTimer = 0;
  const linkModeButton = document.getElementById("link-mode") as HTMLButtonElement;
  let linkMode = false;

  function redrawRelations() {
    relationHandle?.destroy();
    relationHandle = null;
    if (!overlayEl) return;
    if (!aiMode || !linkMode || validRel.length === 0) {
      overlayEl.hidden = true;
      return;
    }
    overlayEl.hidden = false;
    relationHandle = drawRelationOverlay(articleEl, validRel, validAnnotations);
  }

  function activateRelationCluster(relId: string | null) {
    overlayEl?.querySelectorAll<SVGGElement>("[data-rel-hover]").forEach((g) => {
      g.classList.toggle("is-active", relId !== null && g.dataset.relHover === relId);
    });
  }

  linkModeButton.disabled = !(aiAvailable && validRel.length > 0);
  linkModeButton.addEventListener("click", () => {
    linkMode = !linkMode;
    linkModeButton.textContent = linkMode ? "退出连线" : "论证连线";
    linkModeButton.setAttribute("aria-pressed", String(linkMode));
    redrawRelations();
  });

  articleEl.addEventListener("mouseover", (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>("[data-rel-ids]");
    activateRelationCluster(el?.dataset.relIds?.split(",")[0] ?? null);
  });
  articleEl.addEventListener("mouseout", () => activateRelationCluster(null));
  articleEl.addEventListener("click", (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>("[data-rel-ids]");
    if (!el) return;
    const relId = el.dataset.relIds?.split(",")[0];
    if (!relId) return;
    activateRelationCluster(relId);
    // 移动端兜底：中心句/支撑点闪烁定位
    window.clearTimeout(flashTimer);
    articleEl.querySelectorAll<HTMLElement>(`[data-rel-ids*="${relId}"]`).forEach((p) => {
      p.classList.add("rel-flash");
      window.setTimeout(() => p.classList.remove("rel-flash"), 1200);
    });
    flashTimer = window.setTimeout(() => activateRelationCluster(null), 3000);
    if (window.innerWidth < 768) showMobilePanel(relId);
  });

  // 移动端结构卡片：点击中心句弹出底部面板（中心句 + 支撑点列表）
  const mobilePanel = document.getElementById("rel-mobile-panel") as HTMLElement;
  const mobileBody = document.getElementById("rel-mobile-body") as HTMLElement;
  document.getElementById("rel-mobile-close")!.addEventListener("click", hideMobilePanel);
  function hideMobilePanel() { mobilePanel.hidden = true; }
  function showMobilePanel(relId: string) {
    const rel = validRel.find((r) => r.id === relId);
    if (!rel) return;
    const byId = new Map(validAnnotations.map((a) => [a.id, a]));
    const center = byId.get(rel.anchor);
    const rows = rel.points.map((p) => {
      const ann = byId.get(p.annotationId);
      return ann ? `<li>${ann.text}</li>` : "";
    }).join("");
    mobileBody.innerHTML = `
      <p class="rel-mobile-center">${center?.text ?? ""}</p>
      <ul>${rows}</ul>`;
    mobilePanel.hidden = false;
  }

  function setAiMode(enabled: boolean) {
    aiMode = enabled && aiAvailable;
    originalModeButton.classList.toggle("on", !aiMode);
    aiModeButton.classList.toggle("on", aiMode);
    originalModeButton.setAttribute("aria-pressed", String(!aiMode));
    aiModeButton.setAttribute("aria-pressed", String(aiMode));
    articleEl.dataset.mode = aiMode ? "ai" : "original";
    renderAll();
  }
  originalModeButton.addEventListener("click", () => setAiMode(false));
  aiModeButton.addEventListener("click", () => setAiMode(true));
  // 默认 AI 标注模式（仅当文章有可用 AI 标注）
  setAiMode(aiAvailable);

  function saveHighlights() {
    try {
      localStorage.setItem(HIGHLIGHTS_KEY_V2, JSON.stringify(highlights));
    } catch {
      /* 存储不可用（隐私模式/已满）时静默降级为不持久化 */
    }
  }

  function loadHighlights() {
    try {
      let list: Highlight[] = [];
      const rawV2 = localStorage.getItem(HIGHLIGHTS_KEY_V2);
      if (rawV2 === null) {
        // 首次进入 v2：尝试 v1 逐段数据迁移（保数据优先，迁移后清理 v1）
        const rawV1 = localStorage.getItem(HIGHLIGHTS_KEY_V1);
        if (rawV1) {
          const v1: unknown = JSON.parse(rawV1);
          if (Array.isArray(v1)) {
            list = migrateV1ToV2(v1 as LegacyHighlightRecord[], paraText);
            localStorage.setItem(HIGHLIGHTS_KEY_V2, JSON.stringify(list));
            localStorage.removeItem(HIGHLIGHTS_KEY_V1);
          }
        }
      } else {
        const parsed: unknown = JSON.parse(rawV2);
        if (Array.isArray(parsed)) list = parsed as Highlight[];
      }
      // 校验 + quote 锚点重定位：段落内容更新后按引文重新定位，失效区间剔除
      highlights = list
        .filter((h) => typeof h?.id === "string" && Array.isArray(h.ranges) && Array.isArray(h.styles))
        .map((h) => relocateHighlight(h, paraText))
        .filter((h): h is Highlight => h !== null);
    } catch {
      highlights = [];
    }
    renderAll();
  }

  // —— 撤销栈：Ctrl+Z（上限 50，逆操作入栈；P3）——
  type UndoEntry =
    | { type: "add"; highlight: Highlight }
    | { type: "remove"; highlight: Highlight }
    | { type: "remove-range"; highlight: Highlight; range: HighlightRange };
  const undoStack: UndoEntry[] = [];

  function pushUndo(entry: UndoEntry) {
    undoStack.push(entry);
    if (undoStack.length > 50) undoStack.shift();
  }

  function undoLast() {
    const entry = undoStack.pop();
    if (!entry) {
      toast("没有可撤销的操作");
      return;
    }
    if (entry.type === "add") {
      highlights = removeHighlight(highlights, entry.highlight.id);
    } else if (entry.type === "remove") {
      highlights = [...highlights, entry.highlight];
    } else {
      highlights = highlights.map((h) =>
        h.id === entry.highlight.id ? { ...h, ranges: [...h.ranges, entry.range] } : h,
      );
    }
    saveHighlights();
    renderAll();
    toast("已撤销");
  }

  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "z") {
      e.preventDefault();
      undoLast();
    }
  });

  // 选区 → 段落内字符偏移（Range.toString() 统一处理文本节点与元素节点锚定的选区，
  // 避免三击整段 / 从缩进空白处拖选时 startContainer 为元素节点而被丢弃）。
  function pointOffset(para: HTMLElement, node: Node, offset: number): number | null {
    try {
      const range = document.createRange();
      range.selectNodeContents(para);
      range.setEnd(node, offset);
      return range.toString().length;
    } catch {
      return null;
    }
  }

  interface SelectionOffsets {
    paragraphIndex: number;
    start: number;
    end: number;
    text: string;
    rect: DOMRect;
  }

  let current: SelectionOffsets[] | null = null;

  // 选区 → 逐段区间列表：支持跨段落划线，把选区按段落拆分为多个单段区间。
  function selectionToOffsets(): SelectionOffsets[] | null {
    const sel = window.getSelection();
    if (!sel || sel.isCollapsed) return null;
    const range = sel.getRangeAt(0);
    const startContainer = range.startContainer;
    const endContainer = range.endContainer;
    const startEl = startContainer.nodeType === Node.TEXT_NODE
      ? (startContainer as Text).parentElement
      : (startContainer as Element);
    const endEl = endContainer.nodeType === Node.TEXT_NODE
      ? (endContainer as Text).parentElement
      : (endContainer as Element);
    const startPara = startEl ? (startEl.closest(".reading-para") as HTMLElement | null) : null;
    const endPara = endEl ? (endEl.closest(".reading-para") as HTMLElement | null) : null;
    if (!startPara || !endPara) return null;

    const paras: HTMLElement[] = [];
    let inRange = false;
    for (const p of paraEls) {
      if (p === startPara) inRange = true;
      if (inRange) paras.push(p);
      if (p === endPara) break;
    }
    if (paras.length === 0) return null;

    const offsets: SelectionOffsets[] = [];
    for (const para of paras) {
      const index = paraEls.indexOf(para);
      if (index < 0) continue;
      const start = para === startPara ? pointOffset(para, startContainer, range.startOffset) : 0;
      const end = para === endPara ? pointOffset(para, endContainer, range.endOffset) : (paraText[index] ?? "").length;
      if (start === null || end === null || start >= end) continue;
      offsets.push({
        paragraphIndex: index,
        start,
        end,
        text: (paraText[index] ?? "").slice(start, end),
        rect: range.getBoundingClientRect(),
      });
    }
    return offsets.length ? offsets : null;
  }

  function placeFloating(el: HTMLElement, rect: DOMRect, preferAbove = false) {
    const viewport = window.visualViewport;
    const leftEdge = viewport?.offsetLeft ?? 0;
    const topEdge = viewport?.offsetTop ?? 0;
    const width = viewport?.width ?? window.innerWidth;
    const height = viewport?.height ?? window.innerHeight;
    const margin = 8;
    // P3：桌面与移动端统一就近弹出（贴选区上/下方，溢出翻边），不再固定底部
    el.style.right = "auto";
    el.style.bottom = "auto";
    // 面板从触发器方向生长（P0 动效）：显示在选区下方 → origin 朝上；上方 → 朝下
    el.style.transformOrigin = preferAbove ? "center bottom" : "center top";
    const preferredLeft = rect.left + rect.width / 2 - el.offsetWidth / 2;
    el.style.left = `${Math.max(leftEdge + margin, Math.min(preferredLeft, leftEdge + width - el.offsetWidth - margin))}px`;
    const below = rect.bottom + margin;
    const above = rect.top - el.offsetHeight - margin;
    const top = preferAbove
      ? (above >= topEdge + margin ? above : below)
      : (below + el.offsetHeight <= topEdge + height - margin ? below : above);
    el.style.top = `${Math.max(topEdge + margin, Math.min(top, topEdge + height - el.offsetHeight - margin))}px`;
  }

  function showSelectionToolbar() {
    const offs = selectionToOffsets();
    const text = offs?.map((o) => o.text).join(" ") ?? "";
    if (!offs || text.trim().length < 2 || text.trim().length > 300) {
      hide();
      return;
    }
    current = offs;
    toolbar.hidden = false;
    placeFloating(toolbar, offs[0]!.rect);
  }

  const hide = () => {
    toolbar.hidden = true;
    current = null;
    window.getSelection()?.removeAllRanges();
  };

  document.addEventListener("pointerup", (e) => {
    if (toolbar.contains(e.target as Node)) return;
    setTimeout(showSelectionToolbar, 0);
  });

  let selectionTimer = 0;
  document.addEventListener("selectionchange", () => {
    if (!toolbar.hidden) return;
    window.clearTimeout(selectionTimer);
    selectionTimer = window.setTimeout(showSelectionToolbar, 120);
  });

  document.addEventListener("pointerdown", (e) => {
    const t = e.target as HTMLElement;
    if (!toolbar.hidden && !toolbar.contains(t) && !t.closest("mark[data-user-highlight]")) {
      hide();
    }
  });

  // ===== AI 解析邀请码：额度状态 + 输入弹窗 =====
  const quotaText = document.getElementById("ai-quota-text") as HTMLElement;
  const quotaAction = document.getElementById("ai-quota-action") as HTMLButtonElement;
  const inviteModal = document.getElementById("invite-modal") as HTMLElement;
  const inviteInput = document.getElementById("invite-input") as HTMLInputElement;
  const inviteError = document.getElementById("invite-error") as HTMLElement;
  const inviteSubmit = document.getElementById("invite-submit") as HTMLButtonElement;
  const inviteCancel = document.getElementById("invite-cancel") as HTMLButtonElement;

  async function refreshInviteStatus() {
    const me = await api.me();
    if (me.ok && me.data) {
      quotaText.textContent = "已登录 · 不限次";
      quotaAction.hidden = true;
      return;
    }
    const status = await api.inviteStatus();
    if (status.ok && status.data?.active) {
      quotaText.textContent = `邀请码已激活 · 剩余 ${status.data.remaining} 次`;
      quotaAction.textContent = "更换邀请码";
    } else {
      quotaText.textContent = "未登录 · 需邀请码";
      quotaAction.textContent = "输入邀请码";
    }
    quotaAction.hidden = false;
  }

  function openInviteModal(): Promise<boolean> {
    return new Promise((resolve) => {
      inviteError.hidden = true;
      inviteInput.value = "";
      inviteModal.classList.remove("closing");
      inviteModal.hidden = false;
      inviteInput.focus();
      const close = (ok: boolean) => {
        // 关闭动画：先播 250ms 反向过渡（CSS .invite-modal.closing）再隐藏
        inviteModal.classList.add("closing");
        window.setTimeout(() => {
          inviteModal.hidden = true;
          inviteModal.classList.remove("closing");
          inviteSubmit.onclick = null;
          inviteCancel.onclick = null;
          inviteInput.onkeydown = null;
          resolve(ok);
        }, 250);
      };
      inviteSubmit.onclick = async () => {
        const code = inviteInput.value.trim();
        if (!code) {
          inviteError.textContent = "请输入邀请码";
          inviteError.hidden = false;
          return;
        }
        inviteSubmit.disabled = true;
        inviteSubmit.textContent = "激活中…";
        const act = await api.activateInvite(code);
        inviteSubmit.disabled = false;
        inviteSubmit.textContent = "激活";
        if (act.ok && act.data?.active) {
          await refreshInviteStatus();
          close(true);
        } else {
          inviteError.textContent = act.error?.message ?? "邀请码无效";
          inviteError.hidden = false;
        }
      };
      inviteCancel.onclick = () => close(false);
      inviteInput.onkeydown = (e) => {
        if (e.key === "Enter") inviteSubmit.click();
        if (e.key === "Escape") inviteCancel.click();
      };
    });
  }

  quotaAction.addEventListener("click", () => { void openInviteModal(); });
  void refreshInviteStatus();

  async function fetchExplanation(text: string): Promise<string | null> {
    let env = await api.explain(text);
    if (env.ok && env.data) return env.data.explanation;
    if (env.error?.code === "INVITE_REQUIRED") {
      toast("AI 解析需要登录或填写邀请码");
      const activated = await openInviteModal();
      if (!activated) return null;
      env = await api.explain(text);
      if (env.ok && env.data) return env.data.explanation;
    }
    if (env.error?.code === "QUOTA_EXHAUSTED") {
      toast("邀请码额度已用完，请登录或联系管理员获取新邀请码");
      return null;
    }
    toast(env.error?.message ?? "AI 解释失败");
    return null;
  }

  function toast(msg: string) {
    const t = document.createElement("div");
    t.className = "toast";
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => t.remove(), 2000);
  }

  // 共享 tooltip：hover/focus [data-explanation] 显示解释（支持 Markdown）。
  // 悬停常驻：鼠标移到 tooltip 上不隐藏，移开「文字 + tooltip」两者才隐藏。
  let annotationTip: HTMLDivElement | null = null;
  let annotationHideTimer = 0;

  function cancelHideAnnotationTip() {
    window.clearTimeout(annotationHideTimer);
  }

  function hideAnnotationTip() {
    cancelHideAnnotationTip();
    if (annotationTip) annotationTip.hidden = true;
  }

  function scheduleHideAnnotationTip() {
    cancelHideAnnotationTip();
    annotationHideTimer = window.setTimeout(hideAnnotationTip, 150);
  }

  function showAnnotationTip(target: HTMLElement, content: string) {
    if (!annotationTip) {
      annotationTip = document.createElement("div");
      annotationTip.className = "annotation-tip";
      annotationTip.hidden = true;
      document.body.appendChild(annotationTip);
      // 粘性：鼠标移到 tooltip 上取消隐藏，移出再延迟隐藏
      annotationTip.addEventListener("mouseenter", cancelHideAnnotationTip);
      annotationTip.addEventListener("mouseleave", scheduleHideAnnotationTip);
    }
    cancelHideAnnotationTip();
    annotationTip.innerHTML = renderMarkdown(content);
    annotationTip.hidden = false;
    const rect = target.getBoundingClientRect();
    const viewport = window.visualViewport;
    const width = viewport?.width ?? window.innerWidth;
    const height = viewport?.height ?? window.innerHeight;
    const margin = 8;
    if (width <= 600) {
      annotationTip.style.left = `${margin}px`;
      annotationTip.style.right = `${margin}px`;
      annotationTip.style.top = "auto";
      annotationTip.style.bottom = "calc(16px + env(safe-area-inset-bottom))";
      return;
    }
    annotationTip.style.right = "auto";
    annotationTip.style.bottom = "auto";
    const tipRect = annotationTip.getBoundingClientRect();
    const below = rect.bottom + margin;
    const top = below + tipRect.height <= height - margin ? below : Math.max(margin, rect.top - tipRect.height - margin);
    const left = Math.max(margin, Math.min(rect.left + rect.width / 2 - tipRect.width / 2, width - tipRect.width - margin));
    annotationTip.style.top = `${top}px`;
    annotationTip.style.left = `${left}px`;
  }

  function annotationContentOf(node: Node | null): { el: HTMLElement; content: string } | null {
    const el = (node as HTMLElement | null)?.closest?.("[data-explanation]") as HTMLElement | null;
    if (!el) return null;
    const content = el.dataset.explanation ?? "";
    return content ? { el, content } : null;
  }

  document.addEventListener("mouseover", (e) => {
    const hit = annotationContentOf(e.target as Node);
    if (hit) showAnnotationTip(hit.el, hit.content);
  });
  document.addEventListener("mouseout", (e) => {
    const hit = annotationContentOf(e.target as Node);
    // 离开标记时延迟隐藏，给鼠标移到 tooltip 留时间；标记仍聚焦则保持常驻
    if (hit && document.activeElement !== hit.el) scheduleHideAnnotationTip();
  });
  document.addEventListener("focusin", (e) => {
    const hit = annotationContentOf(e.target as Node);
    if (hit) showAnnotationTip(hit.el, hit.content);
  });
  document.addEventListener("focusout", (e) => {
    if ((e.target as HTMLElement).closest?.("[data-explanation]")) hideAnnotationTip();
  });

  // 关键：mousedown 阻止按钮夺焦点（否则选区被清空）
  const preserveSelection = (e: Event) => {
    window.clearTimeout(selectionTimer);
    e.preventDefault();
    e.stopPropagation();
  };
  toolbar.addEventListener("pointerdown", preserveSelection);
  toolbar.addEventListener("mousedown", preserveSelection);

  toolbar.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest("button");
    const selected = current;
    if (!btn || !selected || selected.length === 0) {
      toolbar.dataset.state = "missing-selection";
      toast("选区已失效，请重新选择文字");
      return;
    }
    toolbar.dataset.state = "saving";
    const act = btn.dataset.act as string;
    const text = selected.map((o) => o.text).join(" ");
    let saved = true;
    if (act === "green" || act === "underline" || act === "bold") {
      // 对象模型：一次操作 = 一个 Highlight（可跨段），入撤销栈
      const h = createHighlight(
        selected.map((o) => ({ paragraphIndex: o.paragraphIndex, start: o.start, end: o.end, text: o.text })),
        [act as HighlightStyle],
      );
      pushUndo({ type: "add", highlight: h });
      highlights = [...highlights, h];
      saveHighlights();
      renderAll();
    } else if (act === "explain") {
      toast("AI 解释生成中…");
      const explanation = await fetchExplanation(text);
      if (explanation) {
        const h = createHighlight(
          selected.map((o) => ({ paragraphIndex: o.paragraphIndex, start: o.start, end: o.end, text: o.text })),
          ["underline"],
          { explanation },
        );
        pushUndo({ type: "add", highlight: h });
        highlights = [...highlights, h];
        saveHighlights();
        renderAll();
      } else {
        saved = false;
        toast("AI 解释失败");
      }
    } else if (act === "favorite") {
      const env = await api.addFavorite({
        url: favBtn.dataset.url || location.href,
        title: favBtn.dataset.title || text,
        kind: "quote",
        quote: text,
      });
      saved = env.ok;
      toast(env.ok ? "已收藏金句" : "收藏失败");
    }
    toolbar.dataset.state = saved ? "saved" : "error";
    if (saved) hide();
  });

  function markOffsets(para: HTMLElement, mark: HTMLElement): { start: number; end: number } | null {
    const walker = document.createTreeWalker(para, NodeFilter.SHOW_TEXT);
    let total = 0;
    let cur: Node | null;
    while ((cur = walker.nextNode())) {
      const len = cur.textContent?.length ?? 0;
      if (cur.parentElement === mark) return { start: total, end: total + len };
      total += len;
    }
    return null;
  }

  // 悬停/点按已标注文字 → 浮出菜单（删除整条 / 删除本段），删除入撤销栈（P3 对象模型）
  let hlMenu: HTMLElement | null = null;
  let menuTarget: { highlight: Highlight; range: HighlightRange } | null = null;
  let menuTimer = 0;

  function hideMenu() {
    window.clearTimeout(menuTimer);
    if (hlMenu) hlMenu.hidden = true;
    menuTarget = null;
    document.querySelectorAll("mark.hl-flash").forEach((m) => m.classList.remove("hl-flash"));
  }

  function buildMenu(): HTMLElement {
    const el = document.createElement("div");
    el.className = "hl-menu";
    el.hidden = true;
    el.innerHTML = `
      <button type="button" data-act="remove-all">删除整条</button>
      <button type="button" data-act="remove-para">删除本段</button>`;
    el.addEventListener("mouseenter", () => window.clearTimeout(menuTimer));
    el.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("button");
      const act = btn?.dataset.act;
      if (!act || !menuTarget) return;
      const { highlight: h, range } = menuTarget;
      hideMenu();
      if (act === "remove-all") {
        pushUndo({ type: "remove", highlight: h });
        highlights = removeHighlight(highlights, h.id);
      } else {
        const next = removeRangeFromHighlight(h, range);
        pushUndo({ type: "remove-range", highlight: h, range });
        highlights = next ? highlights.map((x) => (x.id === h.id ? next : x)) : removeHighlight(highlights, h.id);
      }
      saveHighlights();
      renderAll();
      toast("已删除，Ctrl+Z 可撤销");
    });
    document.body.appendChild(el);
    return el;
  }

  function showMenuFor(mark: HTMLElement) {
    // 选中文本期间（选择工具栏可能弹出）不显示菜单，避免两者重叠
    const sel = window.getSelection();
    if (sel && !sel.isCollapsed) return;
    const para = mark.closest(".reading-para") as HTMLElement | null;
    if (!para) return;
    const index = paraEls.indexOf(para);
    const off = markOffsets(para, mark);
    if (index < 0 || !off) return;
    const h = highlightAt(highlights, index, off.start, off.end);
    if (!h) return;
    const range = h.ranges.find((r) => r.paragraphIndex === index && r.start === off.start && r.end === off.end)
      ?? h.ranges.find((r) => r.paragraphIndex === index && r.start <= off.start && off.end <= r.end);
    if (!range) return;
    if (!hlMenu) hlMenu = buildMenu();
    menuTarget = { highlight: h, range };
    hlMenu.hidden = false;
    placeFloating(hlMenu, mark.getBoundingClientRect(), true);
    mark.classList.add("hl-flash");
  }

  document.addEventListener("mouseover", (e) => {
    if (window.matchMedia("(hover: none)").matches) return; // 触摸设备用 click 触发
    const mark = (e.target as HTMLElement).closest("mark[data-user-highlight]") as HTMLElement | null;
    if (mark) showMenuFor(mark);
  });
  document.addEventListener("mouseout", (e) => {
    const mark = (e.target as HTMLElement).closest("mark[data-user-highlight]") as HTMLElement | null;
    if (mark) {
      window.clearTimeout(menuTimer);
      menuTimer = window.setTimeout(hideMenu, 150);
    }
  });
  // 移动端：点按已标注文字弹出菜单（再次点按关闭）
  document.addEventListener("click", (e) => {
    const mark = (e.target as HTMLElement).closest("mark[data-user-highlight]") as HTMLElement | null;
    if (mark && window.matchMedia("(hover: none)").matches) {
      if (hlMenu && !hlMenu.hidden && menuTarget) {
        hideMenu();
        return;
      }
      showMenuFor(mark);
    }
  });

  // 回填：拉取已有划线并重渲染（与新建走同一条渲染路径）
  void loadHighlights();
</script>
