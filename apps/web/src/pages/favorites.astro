---
import Base from "../layouts/Base.astro";
import { listArticles } from "../lib/content";

// url → article id 映射：收藏点击跳转到阅读页，而非原文外链。
const articleIdByUrl: Record<string, string> = {};
for (const a of listArticles()) {
  articleIdByUrl[a.url] = a.id;
}
---
<Base title="我的收藏 · 时政小助手">
  <section class="card">
    <h2>我的收藏</h2>
    <div class="fav-filters" id="fav-filters">
      <button type="button" class="fav-filter on" data-filter="term">术语解析</button>
      <button type="button" class="fav-filter" data-filter="article">文章收藏</button>
      <button type="button" class="fav-filter" data-filter="quote">金句收藏</button>
    </div>
    <div id="fav-list"><p class="item-summary">加载中…</p></div>
  </section>
  <script type="application/json" id="article-id-map" set:html={JSON.stringify(articleIdByUrl).replace(/</g, "\\u003c")}></script>
</Base>

<style>
  /* 术语解析行：复用全局 day-row（border/hover 高亮），对齐「文章收藏」 */
  .term-row { position: relative; flex-wrap: wrap; }
  .term-main { flex: 1 1 200px; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .term-name { font-weight: 700; color: var(--primary); font-family: var(--font-serif); font-size: 15px; }
  .term-expl { color: var(--sub); font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .term-src { font-size: 12px; color: var(--mut); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; text-decoration: none; }
  .term-src:hover { color: var(--primary); }
  .term-actions { display: flex; gap: 6px; margin-left: auto; }
  .term-ask-panel { flex-basis: 100%; margin-top: 8px; padding: 10px 12px; background: var(--surface-2); border-radius: var(--r-sm); }
  @media (max-width: 640px) {
    .term-actions button { min-height: 44px; } /* 触控目标 */
    .term-src { max-width: 100%; }
  }
  .term-suggest { display: flex; flex-direction: column; gap: 6px; }
  .term-q { text-align: left; border: 1px solid var(--line); background: var(--surface); color: var(--primary);
    border-radius: var(--r-sm); padding: 6px 10px; font-size: 13px; cursor: pointer; font-family: inherit; }
  .term-q:hover { border-color: var(--primary); }
  .term-input-row { display: flex; gap: 8px; margin-top: 8px; }
  .term-input { flex: 1; border: 1px solid var(--line); border-radius: var(--r-sm); padding: 7px 10px;
    font-family: inherit; font-size: 13px; background: var(--surface); color: var(--ink); }
  .term-input:focus { outline: 2px solid var(--primary); border-color: transparent; }
  .term-answer { margin-top: 8px; font-size: 14px; line-height: 1.8; color: var(--ink); }
</style>

<script>
  import { api } from "../lib/api";
  import { renderMarkdown } from "../lib/markdown";
  import { loadLocalFavorites, removeLocalFavorite, removeLocalTermFavorite } from "../lib/local-favorites";
  import type { Favorite } from "@kaogong/contracts";

  const esc = (s: unknown): string =>
    String(s ?? "").replace(/[&<>"']/g, (c) => {
      const map: Record<string, string> = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
      return map[c] ?? c;
    });
  const list = document.getElementById("fav-list")!;
  const articleIdByUrl = JSON.parse(document.getElementById("article-id-map")?.textContent ?? "{}") as Record<string, string>;

  let activeFilter: "term" | "article" | "quote" = "term";
  let favorites: Favorite[] = [];

  function rowHtml(f: Favorite): string {
    const articleId = articleIdByUrl[f.url];
    const href = articleId ? `/read/${articleId}/` : f.url;
    const externalAttr = articleId ? "" : ' target="_blank" rel="noopener"';
    const main = f.kind === "quote" ? (f.quote || f.title) : f.title;
    const sub = f.kind === "quote" ? `—— ${f.title}` : (f.source || "官方来源");
    return `
      <div class="day-row fav-row">
        <a href="${esc(href)}"${externalAttr} class="fav-link" style="flex:1">
          <span class="fav-main">${esc(main)}</span>
          ${sub ? `<span class="fav-sub">${esc(sub)}</span>` : ""}
        </a>
        <button type="button" class="btn btn--line btn--sm fav-del" data-id="${esc(f.id)}">删除</button>
      </div>`;
  }

  // —— 术语解析（0018 改版）：只显示「被收藏的术语」（kind=term），UI 对齐「文章收藏」day-row ——
  function termCardHtml(f: Favorite): string {
    const articleId = f.articleId || articleIdByUrl[f.url] || "";
    const href = articleId ? `/read/${articleId}/` : f.url;
    return `
      <div class="day-row term-row">
        <div class="term-main">
          <span class="term-name">「${esc(f.termText || f.title)}」</span>
          <span class="term-expl" title="${esc(f.termExplanation || "")}">${esc(f.termExplanation || "")}</span>
        </div>
        <a class="term-src" href="${esc(href)}" title="${esc(f.title)}">${esc(f.title)} ↗</a>
        <div class="term-actions">
          <button type="button" class="btn btn--line btn--sm term-ask" data-term="${esc(f.termText || "")}" data-expl="${esc(f.termExplanation || "")}">追问</button>
          <button type="button" class="btn btn--line btn--sm term-del" data-id="${esc(f.id)}" data-url="${esc(f.url)}" data-term="${esc(f.termText || "")}">删除</button>
        </div>
        <div class="term-ask-panel" hidden></div>
      </div>`;
  }

  function openAskPanel(btn: HTMLButtonElement): void {
    const panel = btn.closest<HTMLElement>(".term-row")!.querySelector<HTMLElement>(".term-ask-panel")!;
    if (!panel.hidden) { panel.hidden = true; return; }
    const term = btn.dataset.term || "";
    const expl = btn.dataset.expl || "";
    panel.hidden = false;
    panel.innerHTML = '<p class="item-summary">生成建议问题中…</p>';

    void api.termAsk({ term, explanation: expl }).then((env) => {
      if (!env.ok || !env.data) {
        panel.innerHTML = `<p class="item-summary">${esc(env.error?.message ?? "生成失败")}（<a href="/login/">登录</a>或填写邀请码后可追问）</p>`;
        return;
      }
      const suggestions = env.data.suggestions ?? [];
      panel.innerHTML = `
        <div class="term-suggest">
          ${suggestions.length
            ? suggestions.map((s, i) => `<button type="button" class="term-q" data-q="${esc(s)}">${i + 1}. ${esc(s)}</button>`).join("")
            : '<p class="item-summary">暂未生成建议问题，可直接输入。</p>'}
        </div>
        <div class="term-input-row">
          <input type="text" class="term-input" placeholder="输入你的追问…（如：为什么要设置六张网，而不是七张网？）" />
          <button type="button" class="btn btn--solid btn--sm term-go">提问</button>
        </div>
        <div class="term-answer"></div>`;

      const answerEl = panel.querySelector<HTMLElement>(".term-answer")!;
      const doAsk = (q: string): void => {
        answerEl.innerHTML = '<p class="item-summary">AI 思考中…</p>';
        void api.termAsk({ term, explanation: expl, question: q }).then((env2) => {
          if (env2.ok && env2.data?.answer) answerEl.innerHTML = renderMarkdown(env2.data.answer);
          else answerEl.innerHTML = `<p class="item-summary">${esc(env2.error?.message ?? "追问失败")}</p>`;
        });
      };
      panel.querySelectorAll<HTMLButtonElement>(".term-q").forEach((b) => {
        b.addEventListener("click", () => doAsk(b.dataset.q || ""));
      });
      panel.querySelector<HTMLButtonElement>(".term-go")!.addEventListener("click", () => {
        const input = panel.querySelector<HTMLInputElement>(".term-input")!;
        const q = input.value.trim();
        if (q) doAsk(q);
      });
    });
  }

  function renderTerms(): void {
    const entries = favorites.filter((f) => f.kind === "term");
    if (!entries.length) {
      list.innerHTML = '<p class="item-summary">还没有收藏术语——阅读页点正文中的 AI 术语即可收藏（👻→😃）。</p>';
      return;
    }
    list.innerHTML = entries.map(termCardHtml).join("");
    list.querySelectorAll<HTMLButtonElement>(".term-ask").forEach((btn) => {
      btn.addEventListener("click", () => openAskPanel(btn));
    });
    list.querySelectorAll<HTMLButtonElement>(".term-del").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-id") || "";
        const url = btn.getAttribute("data-url") || "";
        const term = btn.getAttribute("data-term") || "";
        if (localMode) {
          removeLocalTermFavorite(url, term); // 本地：只删该术语
        } else {
          await api.removeFavorite(id);
        }
        await load();
      });
    });
  }

  function renderList(): void {
    if (!favorites.length) {
      list.innerHTML = localMode
        ? '<p class="item-summary">还没有本机收藏，去阅读页「👻 收藏本文」添加。</p>'
        : '<p class="item-summary">还没有收藏，去日报页或阅读页「👻 收藏本文」添加。</p>';
      return;
    }
    if (activeFilter === "term") { renderTerms(); return; }
    const filtered = favorites.filter((f) => f.kind === activeFilter);
    if (!filtered.length) {
      list.innerHTML = '<p class="item-summary">该分类暂无收藏。</p>';
      return;
    }
    list.innerHTML = filtered.map(rowHtml).join("");
    list.querySelectorAll("button[data-id]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.getAttribute("data-id") || "";
        if (localMode) {
          removeLocalFavorite(id); // 本地收藏 id = url
          await load();
        } else {
          await api.removeFavorite(id);
          await load();
        }
      });
    });
  }

  let localMode = false;

  async function load(): Promise<void> {
    const env = await api.listFavorites();
    if (!env.ok) {
      // 未登录/网络失败：回退到本机收藏（仅文章收藏，登录后自动回到云端列表）
      const local = loadLocalFavorites();
      if (local.length) {
        favorites = local;
        localMode = true;
        renderList();
        return;
      }
      list.innerHTML = env.error?.code === "AUTH_REQUIRED"
        ? '<p class="item-summary">未登录，收藏保存在本机。还没有本机收藏，去阅读页「👻 收藏本文」添加。</p>'
        : '<p class="item-summary">收藏加载失败，请刷新重试。未登录时收藏保存在本机。</p>';
      return;
    }
    favorites = env.data ?? [];
    localMode = false;
    renderList();
  }

  document.querySelectorAll<HTMLElement>(".fav-filter").forEach((tab) => {
    tab.addEventListener("click", () => {
      activeFilter = (tab.dataset.filter as "term" | "article" | "quote") ?? "term";
      document.querySelectorAll(".fav-filter").forEach((t) => t.classList.toggle("on", t === tab));
      renderList();
    });
  });

  load();
</script>
