---
// 政策档案入口（/policy/）：跳到最新月份。
//
// ⚠️ 正常路径不会走到这里 —— 顶栏与首页的「政策档案」链接已直指
// `/policy/<最新月>/`。这个页面只为**旧书签与外部链接**兜底。
//
// 为什么不用 `Astro.redirect()`：静态构建下它会生成 Astro 自带的跳转页，
// 页面上有一行可见的「Redirecting from /policy/ to /policy/2026-09/」，
// 点进来会闪一下（用户 2026-09-16 反馈）。这里自己写一个只含 meta refresh 的壳，
// 不放任何可见文字，跳转是无感的。
//
// 刻意不引入 Base.astro：跳转壳不需要顶栏、页脚、令牌样式，
// 引入反而会为它多烘一整套资源。
import { listArchiveMonths } from "../../lib/archive";

const latest = listArchiveMonths()[0];
if (!latest) {
  // 无档案数据时不要静默产出一个坏跳转，构建期直接失败（与原实现一致）
  throw new Error("content/archive/ 下没有 archive.json，先跑 scripts/curate-archive.py");
}
const target = `/policy/${latest}/`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={target} />
    <!-- 跳转壳不该被搜索引擎收录，收录了会与目标页重复 -->
    <meta name="robots" content="noindex" />
    <title>政策档案</title>
  </head>
  <body>
    <!-- meta refresh 被禁用时的兜底入口（正常情况下一瞬间就跳走了） -->
    <a href={target}>政策档案</a>
  </body>
</html>
