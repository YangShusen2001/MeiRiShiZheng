---
// 设计令牌产物必须先于 global.css 引入：global.css 里的旧变量名（--bg/--ink/…）是
// 指向 tokens.generated.css 的别名。产物由 packages/design-tokens/generate.mjs 生成。
import "../styles/tokens.generated.css";
import "../styles/global.css";
import fs from "node:fs";
import path from "node:path";
import { listPracticeSets } from "../lib/content";
import { toReviewQuestions, type ReviewQuestion } from "../lib/review";
import { listArchiveMonths } from "../lib/archive";

interface Props {
  title: string;
  description?: string;
  /** 首页用：横向不套 .wrap 的居中窄栏，改由各条横带自带底色与内边距（画布版式）。 */
  bleed?: boolean;
  /**
   * 顶栏形态。`reading` = 阅读页专用的「专注态」（画布 3:175）：主导航与搜索框都不出现，
   * 左区换成「返回今日精选」，右区换成滚动进度，顶栏下沿多一条 2px 阅读进度条（画布 3:190）。
   *
   * 为什么值得单开一个形态而不是只在文章头加个返回链接：画布 02 通篇没有主导航和搜索框，
   * 那是刻意的阅读态设计——读长文时导航是干扰项，真正要的是「回哪去」和「读到哪了」。
   * 直接照搬常态顶栏会把这两件事都丢掉。
   */
  variant?: "default" | "reading";
}
const {
  title,
  description = "每天整理全国时政、申论精读与政策解读，来源均为官方原文。",
  bleed = false,
  variant = "default",
} = Astro.props;
const isReading = variant === "reading";

// 主导航（画布 3:9）：五项纯文字。画布把「搜索」放进了右区搜索框，不占导航位。
//
// 「政策档案」直指**最新月份**，不再走 `/policy/` 那个跳转壳：静态构建下
// `/policy/` 会先出一页 Astro 自带跳转页（页面上有可见的
// 「Redirecting from /policy/ to /policy/2026-09/」），点进来会闪一下
// （用户 2026-09-16 反馈）。内容层每天重建，月份在构建期就是确定的，烘死没问题。
// `/policy/` 仍保留为旧书签的静默兜底。
const LATEST_ARCHIVE_MONTH = listArchiveMonths()[0] ?? "";
const POLICY_HREF = LATEST_ARCHIVE_MONTH ? `/policy/${LATEST_ARCHIVE_MONTH}/` : "/policy/";

const NAV_ITEMS: { href: string; label: string; match?: string }[] = [
  { href: "/", label: "首页" },
  // match：高亮判据与链接目标分开。链接指向最新月，但看**任意**月份时
  // 「政策档案」都该是当前项，所以高亮仍按 /policy 前缀算。
  { href: POLICY_HREF, label: "政策档案", match: "/policy" },
  { href: "/favorites/", label: "收藏" },
  { href: "/practice/", label: "练习" },
  // 错题 = 练习页的第 3 个模式，直接带 hash 过去（/wrong/ 仍保留为兼容入口）。
  // 高亮会落在「练习」上 —— 语义正确：错题本就是练习页的一个模式。
  { href: "/practice/#wrong", label: "错题" },
];
/** 当前项：首页精确匹配，其余按前缀（/policy/2026-09 也算「政策档案」）。 */
const HERE = Astro.url.pathname.replace(/\/+$/, "");
const isActive = (href: string, match?: string): boolean => {
  const base = (match ?? href).replace(/\/+$/, "");
  return base === "" ? HERE === "" : HERE === base || HERE.startsWith(`${base}/`);
};

// 字体配置：本地审核后台上传/选择后写入 src/font-config.json，构建时注入 @font-face 与变量。
let fontCss = "";
try {
  const cfgPath = path.join(process.cwd(), "src", "font-config.json");
  const cfg = JSON.parse(fs.readFileSync(cfgPath, "utf-8")) as { logo?: string | null; nav?: string | null };
  // ⚠️ 站名的自定义字体（cfg.logo）先停用：上传过的是书法体，那是配原先 50px 大 Logo 的；
  // 画布 3:8 的站名是 20px 衬线 700，书法体在这个字号下糊成一团（实测截图确认）。
  // 要恢复「大字书法体 Logo」，把下面这段放回来即可 —— font-config.json 与上传流程都没动。
  // if (cfg.logo) {
  //   fontCss += `@font-face{font-family:"UserLogoFont";src:url("/fonts/uploads/${cfg.logo}") format("woff2");font-display:swap;}`
  //     + `.logo-text{font-family:"UserLogoFont","STXingkai","华文行楷","KaiTi",cursive !important;}`;
  // }
  if (cfg.nav) {
    fontCss += `@font-face{font-family:"UserNavFont";src:url("/fonts/uploads/${cfg.nav}") format("woff2");font-display:swap;}`
      + `.nav a,.nav-auth a{font-family:"UserNavFont",var(--font) !important;}`;
  }
} catch { /* 无配置则用默认字体 */ }

// 今日复习：构建时把每日一练的题集拍平成复习题，注入客户端。
// 复习用**练习题**而不是考点卡 —— 理由见 src/lib/review.ts 顶部注释
// （考点卡答案是长整句、同组高度重叠，当选项会多解）。
const REVIEW_QUESTIONS: ReviewQuestion[] = listPracticeSets().flatMap((set) =>
  toReviewQuestions(set.date, set.questions),
);
const reviewJson = JSON.stringify(REVIEW_QUESTIONS);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script>
      // 主题：v3 收敛为「浅色 / 深色」两套，但**深色排在迁移最后一步**（规范 §8），
      // 所以现在只出浅色——不把没评审过的深色交给用户。跟随系统的分支暂时去掉。
      // 最后一步开启深色时：这里恢复 `matchMedia(...).matches ? "dark" : "light"`，
      // 并把下面导航里注释掉的「主题」按钮放回来即可（令牌产物里已有 [data-theme="dark"] 块）。
      try {
        document.documentElement.dataset.theme = "light";
        localStorage.setItem("kaogong.theme", "light");
      } catch (e) {}
    </script>
    {fontCss && <style set:html={fontCss} />}
  </head>
  <body>
    <script type="application/json" id="review-data" set:html={reviewJson.replace(/</g, "\\u003c")}></script>

    {/* 复习提示条（替代原先的自动弹窗）。
        默认 hidden —— 由 review.ts 在有到期题目、且当天没被关掉时才显出来。
        阅读页不显示：读长文时顶部多一条提示是干扰，与顶栏「专注态」的取舍一致。 */}
    {!isReading && (
      <div class="review-notice" id="review-notice" hidden>
        <span class="review-notice__text" id="review-notice-text"></span>
        <button type="button" class="review-notice__go" id="review-notice-start">前往复习</button>
        <button type="button" class="review-notice__x" id="review-notice-close" aria-label="今天不再提示">×</button>
      </div>
    )}
    <header class={isReading ? "top top--reading" : "top"} id="top">
      <div class="top-l">
        <a class="logo" href="/" aria-label="每日时政">
          <svg class="logo-mark" viewBox="0 0 24 24" aria-hidden="true">
            <rect width="24" height="24" rx="6"></rect>
            <path d="M12 7L8.8 16.4M12.1 13.7L16.4 15.6" fill="none" stroke-width="1.9" stroke-linecap="round"></path>
          </svg>
          <span class="logo-text">每日时政</span>
        </a>
        {isReading ? (
          /* 阅读态左区（画布 3:182）：标识 + 站名 + 返回链接（14×14 左箭头 + 14px Medium 品牌色），gap 4。
             返回目标是首页——画布写「返回今日精选」，首页的头条横带正是今日精选。 */
          <a class="rd-back" href="/">
            <svg class="rd-back__ic" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M8.6 3.1 4.9 7l3.7 3.9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            <span>返回今日精选</span>
          </a>
        ) : (
          <>
            {/* 主导航（画布 3:9）：纯文字五项，没有图标。搜索不占导航位——
                画布把它放在右区搜索框里。当前项由 aria-current 标记，样式只换字重与颜色。 */}
            <nav class="nav" id="nav" aria-label="主导航">
              {NAV_ITEMS.map((item) => (
                <a
                  href={item.href}
                  class="nav-tab"
                  aria-current={isActive(item.href, item.match) ? "page" : undefined}
                >{item.label}</a>
              ))}
              {/* 复习遮罩的入口。画布 Web 导航里没有它（手机端才把「复习」放底导），
                  为了不把功能藏起来，放在导航末尾，样式与导航项一致。 */}
              <button type="button" class="nav-tab nav-btn" id="review-entry">复习</button>
              <a href="/profile/" class="nav-tab nav-mobile-only">我的</a>
            </nav>
          </>
        )}
      </div>
      <div class="top-r">
        {!isReading && (
          <form class="top-search" action="/search/" method="get" role="search">
            <svg viewBox="0 0 14 14" aria-hidden="true">
              <circle cx="6" cy="6" r="4.2" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
              <path d="M9.6 9.6l3.4 3.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
            </svg>
            <input
              id="top-q"
              name="q"
              type="search"
              placeholder="搜索时政 / 政策"
              aria-label="搜索时政 / 政策"
              autocomplete="off"
            />
          </form>
        )}
        {/* 阅读态右区（画布 3:187）：滚动进度。数值由脚本实时写，初始 0%。 */}
        {isReading && <span class="rd-read" id="rd-read">已读 0%</span>}
        <button type="button" class="nav-toggle" id="nav-toggle" aria-label="打开菜单" aria-controls="nav" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </button>
        {/* 深色主题排在迁移最后一步（规范 §8）：届时把下面这行放回来，
            阴影/深色令牌产物已经就绪，不需要改样式。 */}
        {/* <button type="button" class="theme-toggle" id="theme-toggle" title="切换主题">主题</button> */}
        <span class="nav-auth" id="kg-auth"><a href="/login/" class="nav-login">登录</a></span>
      </div>
      {/* 阅读进度条（画布 3:190）：轨道铺满 2px，已读部分品牌色。放在顶栏底沿，
          滚动时常驻可见——画布是静态稿看不出粘性，但进度条不粘就没有意义。 */}
      {isReading && <span class="rd-bar" id="rd-bar" aria-hidden="true"></span>}
    </header>
    <main class={bleed ? "wrap wrap--bleed" : "wrap"}><slot /></main>
    {/* 页脚（画布 3:158）：深靛面板 + 标识 + 三个入口 + 分隔线 + 说明/回到顶部 */}
    <footer class="foot">
      <div class="foot-in">
        <div class="foot-top">
          <a class="foot-brand" href="/">
            <svg class="foot-mark" viewBox="0 0 24 24" aria-hidden="true">
              <rect width="24" height="24" rx="6" />
              <path d="M12 7L8.8 16.4M12.1 13.7L16.4 15.6" fill="none" stroke-width="1.9" stroke-linecap="round" />
            </svg>
            <span class="foot-name">每日时政 · 时政小助手</span>
          </a>
          <nav class="foot-links" aria-label="站内链接">
            <a href="/about/">关于本站</a>
            <a href="/sources/">数据来源</a>
            <a href="/design/">设计规范</a>
          </nav>
        </div>
        <div class="foot-hr"></div>
        <div class="foot-bottom">
          <span>内容均来自官方原文，保留来源与发布时间；AI 概括仅供参考，以原文为准。</span>
          <a class="foot-to-top" href="#top">回到顶部</a>
        </div>
      </div>
    </footer>
    <!-- 底部 Tab 导航：仅移动端显示；桌面端隐藏。
         图形全部照画布 3:1511 的矢量形状与尺寸画（首页 13×13.6 / 复习 13.6×12.8 /
         收藏书签 9.2×13 / 我的 6.8 圆 + 12.8 肩线），一个 emoji 都不用：
         emoji 是彩色位图，跟不了令牌、做不了选中态过渡，换个平台还长不一样。
         项数也照画布取 4 项——画布把搜索放顶栏搜索框，底导只留四个去处。 -->
    <nav class="tabbar" id="tabbar" aria-label="主导航">
      <a href="/" data-tab="home">
        <svg class="tab-ic" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3.5 8.4 10 3.4l6.5 5V17H3.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
        </svg>
        <span>首页</span>
      </a>
      <a href="/practice/" data-tab="practice">
        <svg class="tab-ic" viewBox="0 0 20 20" aria-hidden="true">
          <rect x="3.2" y="3.6" width="13.6" height="12.8" rx="2.4" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
          <path d="M7.4 10.3l1.9 1.9 3.5-3.7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span>复习</span>
      </a>
      <a href="/favorites/" data-tab="fav">
        <svg class="tab-ic" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M5.4 3.6h9.2v13L10 13.2l-4.6 3.4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
        </svg>
        <span>收藏</span>
      </a>
      <a href="/profile/" data-tab="me">
        <svg class="tab-ic" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="7" r="3.4" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M3.6 17a6.4 5.4 0 0 1 12.8 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
        <span>我的</span>
      </a>
    </nav>
    <script>
      import { api } from "../lib/api";
      import { initReview } from "../lib/review";
      import { AVATAR_MARK, avatarIndex, avatarVar } from "../lib/avatar";

      // 主题切换：默认 / 阅读 / 护眼 / 深色（浅色系 + 深色），localStorage 记忆；无记忆跟随系统
      // 深色切换在迁移最后一步开启，所以这段现在是惰性的（themeToggle 为 null 时整段跳过）。
      // 保留代码是为了最后一步只改一行 HTML，不用重写逻辑。
      const THEMES = ["light", "dark"];
      const THEME_LABELS: Record<string, string> = { light: "浅色", dark: "深色" };
      const themeToggle = document.getElementById("theme-toggle");
      if (themeToggle) {
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const LEGACY: Record<string, string> = { light: "light", reading: "light", green: "light", dark: "dark" };
        const initial = LEGACY[localStorage.getItem("kaogong.theme") ?? ""] ?? (systemDark ? "dark" : "light");
        let idx = Math.max(0, THEMES.indexOf(initial));
        const applyTheme = () => {
          const theme = THEMES[idx] ?? "light";
          document.documentElement.dataset.theme = theme;
          themeToggle.textContent = `主题·${THEME_LABELS[theme] ?? ""}`;
          localStorage.setItem("kaogong.theme", theme);
        };
        applyTheme();
        themeToggle.addEventListener("click", () => { idx = (idx + 1) % THEMES.length; applyTheme(); });
      }

      const box = document.getElementById("kg-auth");
      if (box) {
        const session = await api.me();
        if (session.ok && session.data) {
          box.textContent = "";
          // 头像（画布 3:2027）：身份底色圆 + 品牌字形，不用 emoji。
          // session 契约已于 2026-09-15 补上 `avatar` → 顶栏跟随用户在「我的」里挑的那一格；
          // 老会话 / 未设头像时它是空串，avatarIndex 会退回邮箱哈希（同一邮箱永远得同一格）。
          const avatar = document.createElement("span");
          avatar.className = "nav-avatar";
          avatar.style.setProperty("--av", avatarVar(avatarIndex(session.data.avatar, session.data.email)));
          avatar.innerHTML = AVATAR_MARK;
          avatar.setAttribute("aria-hidden", "true");
          const link = document.createElement("a");
          link.href = "/profile/";
          link.textContent = session.data.email.split("@")[0] ?? "账号";
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "nav-logout";
          btn.textContent = "退出";
          const status = document.createElement("span");
          status.className = "nav-auth-status";
          status.setAttribute("role", "status");
          status.setAttribute("aria-live", "polite");
          btn.addEventListener("click", async () => {
            btn.disabled = true;
            btn.textContent = "退出中…";
            status.textContent = "";
            const result = await api.logout();
            if (result.ok) {
              location.reload();
              return;
            }
            status.textContent = result.error?.message ?? "退出失败，请重试";
            btn.textContent = "退出";
            btn.disabled = false;
          });
          box.append(avatar, link, btn, status);
        } else {
          const invite = await api.inviteStatus();
          if (invite.ok && invite.data?.active) {
            box.textContent = "";
            const label = document.createElement("span");
            label.className = "nav-invite";
            label.textContent = `${invite.data.code}（邀请码），剩余 ${invite.data.remaining} 次`;
            const loginLink = document.createElement("a");
            loginLink.href = "/login/";
            loginLink.textContent = "登录";
            box.append(label, loginLink);
          }
        }
      }

      // 阅读进度（画布 3:187「已读 37%」+ 3:190 进度条）：按滚动比例算，rAF 节流。
      // 用 scrollHeight - innerHeight 作分母，而不是整页高度：读到页面最底就是 100%，
      // 否则最后屏永远差一截（用户会觉得进度条卡住）。
      const rdBar = document.getElementById("rd-bar");
      if (rdBar) {
        const rdRead = document.getElementById("rd-read");
        let rdTick = false;
        const updateProgress = () => {
          rdTick = false;
          const doc = document.documentElement;
          const max = doc.scrollHeight - window.innerHeight;
          const pct = max > 0 ? Math.min(100, Math.max(0, Math.round((window.scrollY / max) * 100))) : 100;
          rdBar.style.width = `${pct}%`;
          if (rdRead) rdRead.textContent = `已读 ${pct}%`;
        };
        const onScrollProgress = () => {
          if (rdTick) return;
          rdTick = true;
          requestAnimationFrame(updateProgress);
        };
        window.addEventListener("scroll", onScrollProgress, { passive: true });
        window.addEventListener("resize", onScrollProgress);
        updateProgress();
      }

      // 顶栏：滚动时只加一层阴影（画布没有「下滑收起导航」这套，故 collapsed 已撤），
      // 汉堡按钮只在窄屏出现（rAF 节流：滚动一帧只处理一次，避免 layout 抖动）。
      const topEl = document.getElementById("top");
      if (topEl) {
        const navToggle = document.getElementById("nav-toggle") as HTMLButtonElement | null;
        navToggle?.addEventListener("click", () => {
          const open = topEl.classList.toggle("mobile-open");
          navToggle.setAttribute("aria-expanded", String(open));
          navToggle.setAttribute("aria-label", open ? "关闭菜单" : "打开菜单");
        });
        let scrollTick = false;
        const onScroll = () => {
          if (scrollTick) return;
          scrollTick = true;
          requestAnimationFrame(() => {
            scrollTick = false;
            topEl.classList.toggle("scrolled", window.scrollY > 8);
          });
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }

      // 底部 Tab 当前页高亮（P3）：精确匹配首页，其余按前缀
      const tabbar = document.getElementById("tabbar");
      if (tabbar) {
        const path = location.pathname.replace(/\/+$/, "") || "/";
        for (const a of tabbar.querySelectorAll<HTMLAnchorElement>("a")) {
          const tab = a.dataset.tab;
          const active = tab === "home" ? path === "/" : path.startsWith(a.getAttribute("href")!.replace(/\/+$/, ""));
          if (active) a.classList.add("on");
        }
      }

      // 今日复习：读构建时注入的题目数据，挂载复习遮罩。
      // 不自动弹（原先的每日软闸门已撤）—— 是否提示由 review.ts 里的提示条决定。
      const reviewData = document.getElementById("review-data");
      if (reviewData?.textContent) {
        try {
          initReview(JSON.parse(reviewData.textContent), api);
        } catch (err) {
          console.error("[kaogong] 复习初始化失败", err);
        }
      }
    </script>
  </body>
</html>
