---
// 核心考点卡（画布 3:375）：pad 20 · 圆角 14 · gap 12 · 纸卡底 + 描边。
// 顶行 = 来源标签（h24 胶囊）与发布日期两端对齐；标题 20/26 衬线；要点 14/24；
// 底行 = 左「查看官方原文」+ 右「加入收藏」。
//
// ⚠️ 画布上还有一行 12px accent 的「关键数字」（如「关键数字：天然气产量目标 · 储气能力占消费量比重」），
//    这里**不渲染** —— archive.json 里没有对应字段。拿不到就不编（与收藏卡「摘要」「出处说明」同一条原则），
//    等 pipeline 产出该字段再补。
// 「加入收藏」：`favoriteKindSchema` 已于 2026-09-15 补上 policy，这里**真的接上了**
// （api.addFavorite / removeFavorite）。页面加载时拉一次收藏列表建索引、之后本地查表 ——
// 政策档案一屏有十几张卡，不做「每卡一次请求」。
import type { ArchiveItem as Item } from "../lib/archive";

interface Props {
  it: Item;
}
const { it } = Astro.props;
---

<article class="arc-card">
  <div class="arc-card__top">
    <span class="arc-card__src" title={it.topic}>{it.lib}</span>
    <span class="arc-card__date">{it.date} 发布</span>
  </div>
  <h3 class="arc-card__title">{it.title}</h3>
  {it.gist && <p class="arc-card__gist">{it.gist}</p>}
  <div class="arc-card__foot">
    <a class="arc-card__link" href={it.url} target="_blank" rel="noopener">查看官方原文</a>
    <button class="arc-card__fav" type="button" data-url={it.url} data-title={it.title}>加入收藏</button>
  </div>
  <p class="arc-card__hint" hidden></p>
</article>

<script>
  import { api } from "../lib/api";
  import type { Favorite } from "@kaogong/contracts";

  /** 已收藏的政策：url → favorite id。一次列表请求建索引，卡片多了也不炸。 */
  const favByUrl = new Map<string, string>();
  let loaded = false;

  function paint(btn: HTMLButtonElement): void {
    const on = favByUrl.has(btn.dataset.url || "");
    btn.textContent = on ? "已收藏" : "加入收藏";
    btn.classList.toggle("is-on", on);
    btn.setAttribute("aria-pressed", String(on));
  }

  function say(btn: HTMLButtonElement, text: string): void {
    const hint = btn.closest(".arc-card")?.querySelector(".arc-card__hint");
    if (!(hint instanceof HTMLElement)) return;
    hint.textContent = text;
    hint.hidden = !text;
    if (text) window.setTimeout(() => { hint.hidden = true; }, 5000);
  }

  async function loadIndex(): Promise<void> {
    const env = await api.listFavorites();
    if (env.ok && env.data) {
      for (const f of env.data as Favorite[]) {
        if (f.kind === "policy") favByUrl.set(f.url, f.id);
      }
      loaded = true;
    }
    for (const btn of document.querySelectorAll<HTMLButtonElement>(".arc-card__fav")) paint(btn);
  }

  // 事件委托：一屏十几张卡，不逐个绑定
  document.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>(".arc-card__fav");
    if (!btn || btn.disabled) return;
    const url = btn.dataset.url || "";
    if (!url) return;
    const title = btn.dataset.title || "";
    const existing = favByUrl.get(url);
    btn.disabled = true;
    say(btn, "");
    if (existing) {
      const r = await api.removeFavorite(existing);
      if (r.ok) favByUrl.delete(url);
      else say(btn, r.error?.message ?? "取消收藏失败，请重试");
    } else {
      const r = await api.addFavorite({ url, title, source: "政策档案", kind: "policy" });
      if (r.ok && r.data) favByUrl.set(url, r.data.id);
      else say(btn, r.error?.message ?? "收藏失败，请重试");
    }
    btn.disabled = false;
    paint(btn);
  });

  void loadIndex();
</script>

<style>
  .arc-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: 20px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .arc-card__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
  }
  /* 来源标签（画布 3:377）：h24 · pad 0 10 · 圆角 999 · 品牌浅底 + 品牌深字 */
  .arc-card__src {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: var(--r-full);
    background: var(--primary-soft);
    color: var(--primary-text);
    font-size: var(--font-caption);
    font-weight: 500;
    white-space: nowrap;
  }
  .arc-card__date {
    font-size: var(--font-caption);
    color: var(--mut);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .arc-card__title {
    font-family: var(--font-serif);
    font-size: var(--font-title-s);
    font-weight: 700;
    line-height: var(--line-heading);
    color: var(--ink);
  }
  .arc-card__gist {
    font-size: var(--font-meta);
    line-height: var(--line-ui);
    color: var(--sub);
  }
  .arc-card__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .arc-card__link { font-size: var(--font-meta); font-weight: 500; color: var(--primary); }
  .arc-card__link:hover { text-decoration: underline; }
  /* ⚠️ <button> 的 UA 默认底色是白的 —— 透明按钮必须显式写 background，否则会出白块 */
  .arc-card__fav {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: inherit;
    font-size: var(--font-meta);
    color: var(--sub);
  }
  .arc-card__fav:hover { color: var(--primary); }
  /* 已收藏态：品牌色 + Medium（再点一次是取消收藏） */
  .arc-card__fav.is-on { color: var(--primary); font-weight: 500; }
  .arc-card__hint {
    font-size: var(--font-caption);
    line-height: var(--line-ui);
    color: var(--mut);
    background: var(--surface-2);
    border-radius: var(--r-sm);
    padding: 8px 10px;
  }
  @media (max-width: 640px) {
    .arc-card__fav { min-height: 44px; } /* 触控目标 */
  }
</style>
