---
// 政策档案侧边栏：按年份分组的月份导航，每月标注文件数与核心考点数。
import type { ArchiveSummary } from "../lib/archive";

interface Props {
  grouped: Record<string, ArchiveSummary[]>;
  current: string;
}
const { grouped, current } = Astro.props;
const years = Object.keys(grouped).sort().reverse();
const yearTotal = (rows: ArchiveSummary[]) => rows.reduce((n, r) => n + r.count, 0);
const yearHigh = (rows: ArchiveSummary[]) => rows.reduce((n, r) => n + r.high, 0);
---

<aside class="archive-side" aria-label="档案月份导航">
  <div class="side-head">
    <span class="side-title">政策档案</span>
  </div>
  {
    years.map((year) => (
      <div class="side-group">
        <div class="side-year">
          <span class="y-label">{year} 年</span>
          <span class="y-meta">{grouped[year].length} 个月 · {yearTotal(grouped[year])} 份</span>
        </div>
        {grouped[year].map((row) => (
          <a
            class:list={["side-month", { active: row.month === current }]}
            href={`/policy/${row.month}/`}
            aria-current={row.month === current ? "page" : undefined}
            title={`${row.count} 份文件，核心考点 ${row.high} 份`}
          >
            <span class="m-label">{Number(row.month.slice(5, 7))} 月</span>
            <span class="m-meta">
              <span class="m-count">{row.count}</span>
              {row.high > 0 && <span class="m-high">核心 {row.high}</span>}
            </span>
          </a>
        ))}
      </div>
    ))
  }
  <div class="side-foot">
    全站合计 {years.reduce((n, y) => n + yearTotal(grouped[y]), 0)} 份 ·
    核心 {years.reduce((n, y) => n + yearHigh(grouped[y]), 0)} 份
  </div>
</aside>

<style>
  .archive-side {
    position: sticky;
    top: 76px;
    align-self: start;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 10px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
    box-shadow: var(--shadow-sm);
  }
  .side-head { padding: 0 8px 10px; border-bottom: 1px solid var(--line); margin-bottom: 8px; }
  .side-title { font-size: var(--font-meta); font-weight: 600; color: var(--sub); letter-spacing: 0.04em; }
  .side-group { margin-bottom: 12px; }
  .side-year {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
    padding: 6px 8px 4px;
  }
  .y-label { font-size: var(--font-meta); font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  .y-meta { font-size: var(--font-micro); color: var(--mut); font-variant-numeric: tabular-nums; }
  .side-month {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 38px;
    padding: 0 10px;
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
    font-size: var(--font-meta);
    transition: background var(--dur-sm, 160ms) var(--ease-out, ease);
  }
  .side-month:hover { background: var(--surface-2); }
  .side-month.active { background: var(--primary-soft); color: var(--primary); }
  .side-month:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .m-label { font-variant-numeric: tabular-nums; }
  .m-meta { display: flex; align-items: center; gap: 6px; font-size: var(--font-micro); color: var(--mut); }
  .side-month.active .m-meta { color: var(--primary); }
  .m-count {
    font-variant-numeric: tabular-nums;
    background: var(--surface-2);
    border-radius: 20px;
    padding: 0 6px;
    min-width: 24px;
    text-align: center;
  }
  .side-month.active .m-count { background: #fff; }
  .m-high { color: var(--green); font-weight: 600; white-space: nowrap; }
  .side-foot {
    border-top: 1px solid var(--line);
    padding: 10px 8px 2px;
    font-size: 11.5px;
    color: var(--mut);
    font-variant-numeric: tabular-nums;
  }

  /* 窄屏：侧边栏变顶部横向滚动条，保证 ≥44px 触达高度 */
  @media (max-width: 860px) {
    .archive-side {
      position: static;
      max-height: none;
      display: flex;
      gap: 6px;
      align-items: center;
      padding: 10px;
      overflow-x: auto;
    }
    .side-head, .side-foot, .side-year { display: none; }
    .side-group { display: flex; gap: 6px; margin: 0; }
    .side-month {
      min-height: 44px;
      white-space: nowrap;
      border: 1px solid var(--line);
      justify-content: center;
      gap: 5px;
    }
  }
</style>
